<image webp="{{true}}" class="wall" src="/watercolor/forest-original.webp" mode="scaleToFill"/><view class="page"><form class="panel" bindsubmit="submit"><view class="title">{{setup?'设置新密码':'修改密码'}}</view><view wx:if="{{!setup}}"><label>当前密码</label><view class="field"><image class="icon" mode="aspectFit" src="/watercolor/lock.png"/><input password="{{!shown.currentPassword}}" name="currentPassword" placeholder="当前密码" maxlength="256"/><button bindtap="toggleEye" data-name="currentPassword" aria-label="显示或隐藏当前密码"><image class="icon" mode="aspectFit" src="/watercolor/{{shown.currentPassword?'eye-off':'eye'}}.png"/></button></view></view>
<view><label>新密码</label><view class="field"><image class="icon" mode="aspectFit" src="/watercolor/lock.png"/><input password="{{!shown.newPassword}}" name="newPassword" placeholder="新密码" maxlength="256"/><button bindtap="toggleEye" data-name="newPassword" aria-label="显示或隐藏新密码"><image class="icon" mode="aspectFit" src="/watercolor/{{shown.newPassword?'eye-off':'eye'}}.png"/></button></view></view>
<view><label>确认新密码</label><view class="field"><image class="icon" mode="aspectFit" src="/watercolor/lock.png"/><input password="{{!shown.confirmPassword}}" name="confirmPassword" placeholder="确认新密码" maxlength="256"/><button bindtap="toggleEye" data-name="confirmPassword" aria-label="显示或隐藏确认新密码"><image class="icon" mode="aspectFit" src="/watercolor/{{shown.confirmPassword?'eye-off':'eye'}}.png"/></button></view></view>
<button class="primary" form-type="submit" disabled="{{busy}}">确认修改</button></form></view>
