.voice-hint,.voice-card label{font-size:23rpx;font-weight:400;color:#686b53}.voice-action{margin:14rpx 0}.voice-card .primary:last-child{margin-bottom:0}.stop{background:#934f3d!important}
.retry-actions{display:flex;gap:12rpx}.finish-row{margin:22rpx calc(38rpx + 1px) 0}.cell-heading{font-size:36rpx}

.name-actions{display:flex;gap:12rpx}.name-actions button{flex:1;width:auto;margin:0}
.name-field{box-sizing:border-box;display:flex;align-items:center;height:78rpx;margin:8rpx 0 18rpx;padding:0 18rpx;border:1px solid #bcab87;border-radius:16rpx;background:#fffdf5}
.name-input{flex:1;min-width:0;height:44rpx;line-height:44rpx;margin:0;padding:0;border:0;background:transparent}
