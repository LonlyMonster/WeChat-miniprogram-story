<image class="wall" src="/watercolor/forest-original.jpg" mode="scaleToFill"/><view wx:if="{{loaded}}" class="page bookshelf"><view class="new"><button class="primary" bindtap="start" disabled="{{opening}}"><image class="icon" mode="aspectFit" src="/watercolor/plus.png"/>{{draft ? (draft.state==='ended'?'继续保存':'继续讲') : '讲新故事'}}</button></view>
<view class="top"><text class="brand">{{username}}的书架</text><account family="{{true}}"/></view>
<view class="cabinet"><image class="wood" mode="widthFix" src="/watercolor/cabinet.png"/><view wx:if="{{!visibleBooks.length}}" class="empty-message">讲完故事并为它取名，<view>就能收藏第一本漫画。</view></view>
    <view wx:if="{{visibleBooks.length}}" class="shelf-grid">
      <view class="book book-{{index}}" wx:for="{{visibleBooks}}" wx:key="id">
        <image class="binding" src="/watercolor/shelf-book.png" mode="aspectFit"/>
        <view class="book-cover" data-id="{{item.id}}" bindtap="open" aria-role="button" aria-label="阅读{{item.title}}">
          <image wx:if="{{item.coverPath}}" class="cover-art" src="{{item.coverPath}}" mode="aspectFit"/>
          <view class="details">{{item.label}}</view>
        </view>
      </view>
    </view>
  </view>
  <view class="row pager" wx:if="{{visibleBooks.length}}">
    <button class="page-button" bindtap="prev" disabled="{{page===1}}">上一页</button>
    <picker range="{{pageNumbers}}" value="{{page-1}}" bindchange="jump"><view class="pick">第 {{page}} 页 ▾</view></picker>
    <button class="page-button" bindtap="next" disabled="{{page===pageNumbers.length}}">下一页</button>
  </view>
</view>
<view wx:if="{{loadFailed && !loaded}}" class="page"><button class="primary" bindtap="onShow">重新加载书架</button></view>
