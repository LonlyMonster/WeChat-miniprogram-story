page{height:100%;overflow:hidden}
.page.bookshelf{height:100vh;min-height:0;overflow:hidden;padding:24vh 24rpx env(safe-area-inset-bottom)}
.new{position:absolute;top:calc(24vh - 92rpx);right:28rpx}
.top{font-weight:650}
.cabinet{position:relative;width:100%;max-width:calc(76vh - 232rpx - env(safe-area-inset-bottom));margin:0 auto}
.wood{display:block;width:100%}
.shelf-grid{position:absolute;inset:8% calc(4% + 15rpx) 8%;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:repeat(2,minmax(0,1fr));gap:7% 29rpx;justify-items:center;align-items:end}
.book{position:relative;width:100%;aspect-ratio:398/366;max-height:100%}
.book-2,.book-3{transform:translateY(19rpx)}
.binding{display:block;height:100%;width:100%;position:absolute;inset:0}
.book-cover{position:absolute;inset:0;width:100%;height:100%}
.cover-art{position:absolute;left:12%;top:19%;width:84%;height:74%}
.details{position:absolute;top:5%;left:16%;right:6%;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;text-align:center;font:bold 26rpx/1.35 serif}
.delete,.edit-badge{position:absolute;right:7%;bottom:8%;padding:4rpx;width:46rpx;height:46rpx;min-height:0;background:#fff7e4;border:1px solid #b49a6d;border-radius:10rpx}
.delete-icon{width:32rpx;height:32rpx}
.empty-message{position:absolute;top:25%;left:0;width:100%;transform:translateY(-50%);text-align:center;font-weight:600}
.pager{margin:29rpx 15rpx 0}
.pager .page-button,.pager .pick{
  display:flex;
  align-items:center;
  justify-content:center;
  height:76rpx;
  padding:0 22rpx;
  font-size:25rpx;
  line-height:1.2;
  margin:0;
}
.pager .page-button{min-width:144rpx}
.pager .pick{width:auto;border:0}
