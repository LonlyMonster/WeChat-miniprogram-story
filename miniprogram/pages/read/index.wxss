.read-cell+.read-cell{border-top:1px solid #d8cbb1;margin-top:24rpx;padding-top:12rpx}.read-art{position:relative;max-width:462rpx;margin:auto}
.title-row{display:flex;align-items:center;flex-wrap:wrap;gap:12rpx}
.book-name{display:flex;align-items:center;gap:8rpx;max-width:100%;min-width:0;overflow-wrap:anywhere}
.book-name input{width:10em}
.book-actions{position:relative;display:grid;grid-template-columns:repeat(2,44px);place-items:center;margin-left:auto;padding:1px 0;border:1px solid #d7c8a9;border-radius:28px;background:#faf2df}
.book-actions::before{content:"";position:absolute;left:50%;top:10px;bottom:10px;width:1px;background:#d7c8a9;pointer-events:none}
.book-actions button{width:36px;height:36px;min-height:36px;padding:0;background:transparent;border:0;border-radius:50%;font-size:14px}
.book-actions .icon{width:24px;height:24px}
.title-row{padding-bottom:18rpx;border-bottom:1px solid #ded1b7}
.caption{line-height:1.65;padding:8rpx 0;white-space:pre-wrap;overflow-wrap:anywhere}
.cell-number{display:block;font-size:23rpx;color:#726c58;margin-bottom:4rpx}
.caption-edit{border-bottom:1px dashed #a9ad91;padding-bottom:4rpx}
.caption textarea{
  margin:0;
  min-height:42px;
  padding:8px 10px;
  background:#fff;
}
.title-row input{flex:1;min-width:0}.viewer{position:fixed;inset:0;background:#fff8e9;z-index:5}.viewer-pages{width:100%;height:100%}.viewer-cell{height:100%;box-sizing:border-box;padding:30rpx;display:flex;flex-direction:column;justify-content:center;align-items:center}.viewer-picture{width:100%;height:88vw;max-height:65vh}.viewer-text{width:100%;max-height:18vh;margin:20rpx 0}.viewer-close{position:absolute;z-index:2;right:16rpx;top:12rpx;background:transparent;border:0}
